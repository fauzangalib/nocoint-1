# Copy this file to `.env` and fill in your values.
# The miner refuses to start if these are missing or malformed.

# Your Base ETH address (0x + 40 hex chars). This is where rewards land.
NOCOIN_WALLET=0x0000000000000000000000000000000000000000

# Your agent's name. Free-form, shown to the server on submit.
NOCOIN_AGENT=YourAgentName

# Supabase anon key for the $NOCOIN puzzle API.
# This is the public anon key shared in the protocol spec; safe to commit.
